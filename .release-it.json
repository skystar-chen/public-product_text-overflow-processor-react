{
  "git": {
    "requireBranch": ["main", "version-1x", "version-2x"],
    "tagMatch": "v[0-9]*.[0-9]*.[0-9]*",
    "requireCleanWorkingDir": true,
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "v${version}",
    "tagArgs": ["--sign"],
    "push": true
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": "angular"
    }
  },
  "hooks": {
    "before:init": [
      "node scripts/check-node.mjs",
      "pnpm format:check",
      "pnpm lint",
      "pnpm lint:style",
      "pnpm typecheck",
      "pnpm test:ci"
    ],
    "after:bump": ["pnpm build"]
  }
}
