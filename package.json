{
  "name": "text-overflow-processor-react",
  "version": "1.1.30",
  "description": "text overflow process for react",
  "typings": "./lib/index.d.ts",
  "types": "./lib/index.d.ts",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./style": "./lib/index.css"
  },
  "files": [
    "lib"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "keywords": [
    "react",
    "text-overflow",
    "text-ellipsis",
    "text-fold"
  ],
  "author": "chenxingxing",
  "license": "MIT",
  "engines": {
    "node": "20.11.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skystar-chen/public-product_text-overflow-processor-react/tree/version-1x"
  },
  "homepage": "https://github.com/skystar-chen/public-product_text-overflow-processor-react/tree/version-1x",
  "bugs": {
    "url": "https://github.com/skystar-chen/public-product_text-overflow-processor-react/issues",
    "email": "3034474728@qq.com"
  },
  "scripts": {
    "prepare": "husky",
    "start": "react-scripts start",
    "build": "NODE_OPTIONS=--openssl-legacy-provider webpack --progress",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --watchman=false --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:style": "stylelint \"src/**/*.{css,scss}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eject": "react-scripts eject",
    "release": "release-it",
    "prepare:publish-package": "node scripts/prepare-publish-package.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.2.2",
    "@babel/plugin-proposal-optional-chaining": "7.13.12",
    "@babel/preset-env": "7.3.1",
    "@babel/preset-react": "7.0.0",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-angular": "19.8.1",
    "@release-it/conventional-changelog": "^8.0.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "20.11.1",
    "@types/react": "^18.0.20",
    "@types/react-dom": "^18.0.9",
    "babel-loader": "8.0.5",
    "clean-webpack-plugin": "0.1.19",
    "css-loader": "3.6.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-react-app": "7.0.1",
    "eslint-plugin-import": "2.31.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "mini-css-extract-plugin": "^1.6.2",
    "optimize-css-assets-webpack-plugin": "^6.0.1",
    "postcss-loader": "^3.0.0",
    "postcss-preset-env": "^6.7.2",
    "prettier": "3.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intersection-observer": "^9.16.0",
    "react-scripts": "5.0.1",
    "release-it": "^17.11.0",
    "sass": "^1.90.0",
    "sass-loader": "8.0.2",
    "style-loader": "1.3.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-loader": "5.0.0",
    "typescript": "^4.9.5",
    "webpack": "4.46.0",
    "webpack-cli": "^4.10.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "lint-staged": {
    "*.{cjs,mjs,js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,scss}": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
